# Server-only. The API reads process.env.DATABASE_URL (Neon pooled string).
# Do not create VITE_DATABASE_URL. Vite would ship that value to the browser.
DATABASE_URL=

# Set by the Neon integration. The API does not read it.
# DATABASE_URL_UNPOOLED=

# Used only when DATABASE_URL is unset.
# POSTGRES_URL=
